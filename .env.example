# ===== Docker Compose 部署用（放项目根目录） =====
# 使用前复制成本目录的 .env：
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env
# 然后填入真实值，再执行  docker compose up -d --build

# DeepSeek 大模型密钥（必填，面试对话靠它）
DEEPSEEK_API_KEY=sk-your-deepseek-key
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat

# JWT 密钥（必填，随便填一串足够长的随机字符串即可，用于登录令牌签名）
SECRET_KEY=please-change-me-to-a-random-string

# 数据库 / Redis 密码（容器内网使用，一般不用改）
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redispass

# 百炼(DashScope) 向量密钥，用于 RAG 题库语义检索（建议填；留空则检索功能不可用）
EMBEDDING_API_KEY=sk-your-dashscope-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 管理员邮箱：注册时邮箱与此一致的用户自动成为管理员（可留空）
ADMIN_EMAIL=
